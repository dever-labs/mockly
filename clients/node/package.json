{
  "name": "@dever-labs/mockly-driver",
  "version": "0.16.0",
  "description": "Node.js client for Mockly — start/stop servers and manage HTTP mocks in tests",
  "keywords": [
    "mock",
    "testing",
    "http",
    "integration-test",
    "mockly",
    "test-server",
    "driver"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dever-labs/mockly.git",
    "directory": "clients/node"
  },
  "bugs": {
    "url": "https://github.com/dever-labs/mockly/issues"
  },
  "homepage": "https://github.com/dever-labs/mockly/tree/main/clients/node#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "mockly-install": "./bin/install.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json && npm run build:cjs",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs --external:js-yaml --target=node18 --banner:js=\"const __mockly_import_meta_url = require('url').pathToFileURL(__filename).href;\" --define:import.meta.url=__mockly_import_meta_url",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "optionalDependencies": {
    "@dever-labs/mockly-driver-darwin-arm64": "0.16.0",
    "@dever-labs/mockly-driver-darwin-x64": "0.16.0",
    "@dever-labs/mockly-driver-linux-arm64": "0.16.0",
    "@dever-labs/mockly-driver-linux-x64": "0.16.0",
    "@dever-labs/mockly-driver-win32-x64": "0.16.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
