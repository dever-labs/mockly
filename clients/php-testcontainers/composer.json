{
    "name": "dever-labs/mockly-testcontainers",
    "description": "Testcontainers module for Mockly — run Mockly as a Docker container in tests",
    "type": "library",
    "license": "MIT",
    "keywords": ["mock", "testing", "http", "integration-test", "mockly", "testcontainers", "docker"],
    "homepage": "https://github.com/dever-labs/mockly/tree/main/clients/php-testcontainers",
    "support": {
        "issues": "https://github.com/dever-labs/mockly/issues",
        "source": "https://github.com/dever-labs/mockly"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "testcontainers/testcontainers": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Mockly\\Testcontainers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mockly\\Testcontainers\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --exclude-group integration"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
