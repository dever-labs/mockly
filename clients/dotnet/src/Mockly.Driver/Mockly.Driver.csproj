<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <_SdkMajorVersion>$(NETCoreSdkVersion.Split('-')[0].Split('.')[0])</_SdkMajorVersion>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_SdkMajorVersion).0', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>Mockly.Driver</PackageId>
    <Version>0.14.0</Version>
    <Authors>dever-labs</Authors>
    <Description>Mockly is a single binary that mocks HTTP, gRPC, Kafka, AMQP, MQTT, Redis, SMTP, and a dozen other protocols for integration tests — one process instead of a dozen Docker containers. Mockly.Driver is the C# client: it downloads the right platform binary automatically, starts/stops the server from your test process, and gives you a typed API to register mocks, inject faults, and manage scenarios.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dever-labs/mockly/tree/main/clients/dotnet</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/dever-labs/mockly</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mock testing http integration-test mockly protocol-mocking grpc kafka</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Mockly.Driver.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Bundle the MSBuild targets file — NuGet auto-applies it to consuming projects -->
  <ItemGroup>
    <None Include="build\Mockly.Driver.targets" Pack="true" PackagePath="build\"/>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md"/>
  </ItemGroup>

  <!-- Bundle platform-native binaries — populated by CI before pack, ignored locally -->
  <ItemGroup>
    <None Include="runtimes\linux-x64\native\mockly" Pack="true" PackagePath="runtimes\linux-x64\native\" Condition="Exists('runtimes\linux-x64\native\mockly')"/>
    <None Include="runtimes\linux-arm64\native\mockly" Pack="true" PackagePath="runtimes\linux-arm64\native\" Condition="Exists('runtimes\linux-arm64\native\mockly')"/>
    <None Include="runtimes\osx-x64\native\mockly" Pack="true" PackagePath="runtimes\osx-x64\native\" Condition="Exists('runtimes\osx-x64\native\mockly')"/>
    <None Include="runtimes\osx-arm64\native\mockly" Pack="true" PackagePath="runtimes\osx-arm64\native\" Condition="Exists('runtimes\osx-arm64\native\mockly')"/>
    <None Include="runtimes\win-x64\native\mockly.exe" Pack="true" PackagePath="runtimes\win-x64\native\" Condition="Exists('runtimes\win-x64\native\mockly.exe')"/>
  </ItemGroup>
</Project>
